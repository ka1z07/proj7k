# /etc/systemd/system/proj7k-catalog-crawl.service — one daily pass over osu!'s 7K listings.
# Known charts are only refreshed (official SR, status, mapper); new ones are downloaded and evaluated.
# Then anything the running engine has not evaluated yet is re-evaluated (after a `git pull`).
[Unit]
Description=proj7k catalog crawl
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=proj7k
WorkingDirectory=/opt/proj7k
Environment=PYTHONPATH=/opt/proj7k/src
# OSU_CLIENT_ID=... and OSU_CLIENT_SECRET=..., owned by root, mode 600.
EnvironmentFile=/etc/proj7k/osu.env
ExecStart=/opt/proj7k/.venv/bin/python -m proj7k.catalog --db /var/lib/proj7k/catalog.sqlite3 crawl --status all
ExecStartPost=/opt/proj7k/.venv/bin/python -m proj7k.catalog --db /var/lib/proj7k/catalog.sqlite3 refresh
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/proj7k
PrivateTmp=true
