# Windows batch files must keep CRLF line endings.
*.cmd text eol=crlf
# The engine's version hashes these files byte for byte; a CRLF checkout must not change it.
src/proj7k/engine/*.json text eol=lf
src/proj7k/dan_table.json text eol=lf
# Shell scripts run on Linux / macOS; a CRLF checkout breaks bash at `set -o pipefail`.
*.sh text eol=lf
